{
  "name": "oromia-fleet-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.13.0"
  },
  "workspaces": [
    "apps/admin-web",
    "apps/driver-mobile",
    "packages/*"
  ],
  "scripts": {
    "contracts:generate": "npm run generate --workspace=@oromia/api-contracts",
    "contracts:check": "npm run check --workspace=@oromia/api-contracts",
    "translations:check": "npm run check --workspace=@oromia/localization",
    "web:dev": "npm run dev --workspace=@oromia/admin-web",
    "web:lint": "npm run lint --workspace=@oromia/admin-web",
    "web:typecheck": "npm run typecheck --workspace=@oromia/admin-web",
    "web:test": "npm run test --workspace=@oromia/admin-web",
    "web:build": "npm run build --workspace=@oromia/admin-web",
    "mobile:start": "npm run start --workspace=@oromia/driver-mobile",
    "mobile:lint": "npm run lint --workspace=@oromia/driver-mobile",
    "mobile:typecheck": "npm run typecheck --workspace=@oromia/driver-mobile",
    "mobile:test": "npm run test --workspace=@oromia/driver-mobile",
    "openapi:validate": "node infrastructure/scripts/validate-openapi.mjs",
    "docs:check": "node infrastructure/scripts/check-documentation.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "yaml": "2.9.0"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "brace-expansion": "5.0.8",
    "esbuild": "0.28.1",
    "js-yaml": "4.3.0",
    "lightningcss": "1.30.1",
    "minimatch": "10.2.5",
    "postcss": "8.5.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-test-renderer": "19.2.3",
    "sharp": "0.35.3"
  }
}
