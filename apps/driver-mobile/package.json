{
  "name": "@oromia/driver-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "config:validate": "expo config --type public"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@oromia/localization": "file:../../packages/localization",
    "@oromia/shared-types": "file:../../packages/shared-types",
    "@react-native-community/netinfo": "12.0.1",
    "base64-js": "1.5.1",
    "expo": "~57.0.8",
    "expo-camera": "~57.0.0",
    "expo-crypto": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-location": "~57.0.0",
    "expo-secure-store": "~57.0.0",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "nativewind": "5.0.0-preview.4",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-css": "3.0.7",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.14",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.0",
    "jest": "29.7.0",
    "jest-expo": "57.0.2",
    "postcss": "8.5.23",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "moduleNameMapper": {
      "\\.(css)$": "<rootDir>/src/__tests__/support/styleMock.js"
    },
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|expo-.*|@expo/.*|@oromia/.*)/)"
    ]
  }
}
