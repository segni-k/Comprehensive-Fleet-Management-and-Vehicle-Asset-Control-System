APP_NAME="Oromia Fleet Platform API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_VERSION=0.1.0
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=oromia_fleet
DB_USERNAME=oromia_fleet
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

API_RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BYTES=10485760
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXIES=
IDENTITY_PASSWORD_MINIMUM_LENGTH=12
IDENTITY_PASSWORD_HISTORY_COUNT=5
IDENTITY_PASSWORD_EXPIRES_AFTER_DAYS=90
IDENTITY_LOCKOUT_ATTEMPTS=5
IDENTITY_LOCKOUT_MINUTES=15
IDENTITY_ACCESS_TOKEN_MINUTES=15
IDENTITY_REFRESH_TOKEN_DAYS=30
IDENTITY_TRUSTED_SESSION_HOURS=12
IDENTITY_MFA_ISSUER="Fleet Management System"
IDENTITY_MFA_WINDOW=1
IDENTITY_BREAK_GLASS_MAXIMUM_MINUTES=60
HEALTH_CHECK_DATABASE=true
HEALTH_CHECK_REDIS=true
HEALTH_CHECK_QUEUE=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
